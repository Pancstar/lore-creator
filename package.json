{
	"name": "lore-creator",
	"version": "0.9.4",
	"description": "Design fictional universes: branching timelines, versioned story fragments, custom time systems and structured worldbuilding entities.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "eslint .",
		"build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"worldbuilding",
		"timeline",
		"writing"
	],
	"author": "PancstaR",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.2",
		"esbuild": "^0.25.12",
		"eslint": "^10.8.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "1.13.0",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.65.0",
		"vitest": "^3.2.7"
	}
}
